PORT=3001
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_CLASSIFIER_MODEL=
GEMINI_SECONDARY_MODEL=gemini-3.6-flash
# Blank classifier disables optional remote telemetry to conserve free-tier quota.
# Keep the browser timeout above RAG plus BOTH generation attempt deadlines.
GEMINI_CLASSIFIER_TIMEOUT_MS=3000
GEMINI_GENERATION_TIMEOUT_MS=30000
GEMINI_MAX_OUTPUT_TOKENS=512
RAG_REQUEST_TIMEOUT_MS=12000
JWT_SECRET=replace_with_a_long_random_string
# RELEASE BLOCKER: keep false only for controlled internal testing. Set true
# before public release. Counters and would-ban audit logs remain active either way.
BAN_ENFORCEMENT_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
EMBEDDED=false
EMBED_ALLOWED_ORIGINS=https://www.yourwordpresssite.com
EMBED_CLIENT_URL=https://chat.yourdomain.com
ENABLE_IMAGE_OCR=true
OCR_LANGUAGE=eng
OCR_MAX_IMAGES_PER_PAGE=3
OCR_MIN_TEXT_LENGTH=40
# Canonical daily JSONL audit log base path.
AI_RESPONSE_LOG_PATH=logs/ai-responses.jsonl
# Human-readable daily Markdown companion base path.
HUMAN_READABLE_LOG_PATH=logs/conversation-transcript.md
# Separate JSONL base path for conversation active/inactive status entries.
CONVERSATION_STATUS_LOG_PATH=logs/conversation-status.jsonl
# Optional persistent Conversation History archive metadata path (default: server/data/archived-conversations.jsonl).
# DASHBOARD_CONVERSATION_ARCHIVE_PATH=/persistent/data/archived-conversations.jsonl
# Conversations are invalidated after 10 minutes without new messages by default.
CHAT_CONVERSATION_IDLE_TIMEOUT_MS=600000
# Optional. Set this to share temporary bans/violation windows/exemptions
# across multiple server instances via Redis instead of the per-process
# file/memory store. Leave unset for a single-instance deployment.
# REDIS_URL=redis://localhost:6379/0

# Chat error email: one attempt per rolling 24 hours. Recipients come from
# dashboard/admin account emails; see docs/gemini-usage-alerts.md.
# Gmail sender account; leave blank to disable delivery.
GMAIL_USER=
# Google app password, not your regular account password.
GMAIL_APP_PASSWORD=
# Optional: persistent cooldown file for a SINGLE server process.
# GEMINI_ALERT_STATE_PATH=/persistent-data/gemini-usage-alert.json
# With REDIS_URL, use one shared key across all instances of this app.
# GEMINI_ALERT_REDIS_KEY=oksbdc:gemini-usage-alert

# Automatically enter saved-response-only lite mode on unusually high chat traffic.
CHAT_TRAFFIC_MAX_REQUESTS=300
CHAT_TRAFFIC_WINDOW_MS=60000
CHAT_LITE_MODE_HOLD_MS=600000
# Optional shared Redis namespace and independent one-hour administrator email cooldown.
# CHAT_TRAFFIC_REDIS_PREFIX=oksbdc:chat-traffic
# CHAT_TRAFFIC_ALERT_REDIS_KEY=oksbdc:chat-traffic:alert
# CHAT_TRAFFIC_ALERT_STATE_PATH=/persistent-data/chat-traffic-alert.json

# Optional persistent staff review history path (default: server/data/conversation-reviews.jsonl).
# DASHBOARD_CONVERSATION_REVIEW_PATH=/persistent/data/conversation-reviews.jsonl
