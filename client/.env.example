# Optional general API server origin/base. In a same-origin Express deployment,
# leave this blank and requests use the current origin.
# Vite development has no API proxy; set this in client/.env for local work:
# VITE_API_BASE_URL=http://localhost:3001
# For a separate production API: VITE_API_BASE_URL=https://chat.yourdomain.com

# Cross-origin iframe deployment settings. These values are embedded in the
# browser bundle and are not secrets.
VITE_EMBEDDED=false
# VITE_EMBED_API_BASE_URL=https://chat.yourdomain.com

# Optional: show a header button in the chat widget that expires the active
# conversation for QA/testing. Leave unset or false in production builds.
VITE_SHOW_EXPIRE_CONVERSATION_TEST_BUTTON=false

# Maximum time for one chat request, including streamed responses. The browser
# aborts the request and shows a retry message when this deadline is reached.
VITE_CHAT_REQUEST_TIMEOUT_MS=90000

# Optional: allow users to dismiss the sensitive-information/PII notice shown
# above the chat messages. Dismissal lasts for the current browser tab session.
VITE_ALLOW_PII_DISCLAIMER_DISMISS=false
